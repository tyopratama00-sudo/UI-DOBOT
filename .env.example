# =====================================================================
#  Robot Photobooth – environment configuration
#  Copy to .env and adjust. Values marked (admin) can also be changed at
#  runtime from the admin panel → Configuration (DB overrides win).
#  Secrets live ONLY here (never in the booth bundle or in the database).
# =====================================================================

NODE_ENV=development
HOST=0.0.0.0
PORT=8080

# PostgreSQL connection
DATABASE_URL=postgresql://photobooth:photobooth@localhost:5432/photobooth?schema=public

# Public base URL of this server (booth/admin/API). Used for webhooks & mock QR.
APP_URL=http://localhost:8080
# Only needed if the booth is served from a different origin than the API.
API_URL=
# Base URL that goes into the gallery QR code (e.g. https://photo.domain.com).
# Defaults to APP_URL. Must be reachable from the customer's phone.
PUBLIC_GALLERY_URL=
# Comma separated origins allowed to call the API cross-origin (normally empty).
CORS_ORIGINS=
# Set to true when running behind a reverse proxy / Cloudflare Tunnel.
TRUST_PROXY=false

# ---------------------------------------------------------------- security
# Required in production: long random strings (e.g. `openssl rand -base64 48`).
JWT_SECRET=
MEDIA_SIGNING_SECRET=
# Optional: if set, the booth must be opened once with ?device=<key> (stored locally).
BOOTH_DEVICE_KEY=
# First admin account (created at first start if no admin exists).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------------------------------------------------------------- payment
# mock | midtrans | xendit
PAYMENT_PROVIDER=mock
MOCK_WEBHOOK_SECRET=mock-webhook-secret-change-me
# Base URL encoded in the mock QR (scan with a phone on the same LAN). Defaults to APP_URL.
MOCK_PAY_URL_BASE=
# Midtrans (Core API QRIS)
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUCTION=false
MIDTRANS_QRIS_ACQUIRER=gopay
# Xendit (QR Codes API)
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# (admin) QR validity in minutes
PAYMENT_EXPIRY_MINUTES=5

# ---------------------------------------------------------------- camera (admin)
# webcam (browser getUserMedia) | mock | gphoto2 | digicamcontrol | command
CAMERA_DRIVER=webcam
CAMERA_PREVIEW_FIT=cover
CAMERA_MIRROR_PREVIEW=true
CAMERA_PREVIEW_ROTATION=0
CAMERA_CAPTURE_ROTATION=0
CAMERA_MIRROR_CAPTURE=false
CAMERA_DEVICE_ID=
CAMERA_WIDTH=1920
CAMERA_HEIGHT=1080
CAMERA_DIGICAM_URL=http://127.0.0.1:5513
CAMERA_GPHOTO2_BIN=gphoto2
# For CAMERA_DRIVER=command, must contain {output}
CAMERA_CAPTURE_COMMAND=
# Optional MJPEG live-view URL for the command driver
CAMERA_PREVIEW_URL=

# ---------------------------------------------------------------- robot (admin)
# mock | serial | tcp | websocket | rest | mqtt
ROBOT_DRIVER=mock
ROBOT_HOST=127.0.0.1
ROBOT_PORT=9000
ROBOT_SERIAL_PORT=COM3
ROBOT_BAUD_RATE=115200
# For websocket / rest / mqtt (e.g. ws://10.0.0.5:9001, http://10.0.0.5:8000, mqtt://broker:1883)
ROBOT_URL=
ROBOT_TOKEN=
ROBOT_MQTT_TOPIC=photobooth/robot
ROBOT_MQTT_USERNAME=
ROBOT_MQTT_PASSWORD=
ROBOT_MOVE_TIMEOUT_MS=15000
# Physical positions of angles 1..N
ROBOT_ANGLES_FILE=config/angles.json

# ---------------------------------------------------------------- printer (admin)
# mock | system (Windows print spooler / CUPS)
PRINTER_DRIVER=mock
# Exact Windows printer name (Admin → Diagnostics lists installed printers)
PRINTER_NAME=
# 4x6 inch @ 300 DPI
PRINT_WIDTH_PX=1200
PRINT_HEIGHT_PX=1800
PRINT_DPI=300
PRINT_SECONDS_PER_COPY=15
PRINT_FORMAT=jpeg

# ---------------------------------------------------------------- storage
# local (booth disk / NAS path) | s3 (S3-compatible: AWS, R2, MinIO, Wasabi…)
STORAGE_PROVIDER=local
# Working storage (always local, offline-safe). UNC/NAS paths work, e.g. \\nas\photobooth
STORAGE_PATH=./storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PREFIX=
# If the bucket/CDN is public, files are linked directly instead of presigned.
S3_PUBLIC_URL=
# server: gallery pages served by this server | static: HTML+files uploaded to S3
GALLERY_MODE=server

# ---------------------------------------------------------------- session (admin)
PHOTO_ANGLES=10
SHOTS_PER_ANGLE=2
COUNTDOWN_SECONDS=3
READY_SECONDS=5
RETAKE_LIMIT=2

PRICE_FIRST_PRINT=65000
PRICE_ADDITIONAL_PRINT=15000
MAX_PRINT_QUANTITY=10

GALLERY_EXPIRATION_HOURS=24

# ---------------------------------------------------------------- operations
LOG_LEVEL=info
LOG_DIR=./logs
# Delete session files N days after the session ended (0 = keep forever)
DATA_RETENTION_DAYS=30
INTERNET_CHECK_URL=https://www.google.com/generate_204
# Components that block new sessions (maintenance screen) when down
CRITICAL_COMPONENTS=database,storage,camera,robot,printer,payment
# Development only: multiply UI waits (0.1 = 10x faster), show dev tools
TIMING_SCALE=1
DEV_TOOLS=true
